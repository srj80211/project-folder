   "source": [
    "# Load and clean data\n",
    "df = load_and_clean_data(FILE_PATH)\n",
    "print(f\"Cleaned data shape: {df.shape}\")\n",
    "print(f\"Duration range: {df['trip_duration_sec'].min():.0f}-{df['trip_duration_sec'].max():.0f} sec\")\n",
    "print(f\"Passenger range: {df['passenger_count'].min()}-{df['passenger_count'].max()}\")\n",
    "print(f\"Distance range: {df['distance_km'].min():.2f}-{df['distance_km'].max():.2f} km\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "# Sample for clustering\n",
    "coords = df[['pickup_latitude', 'pickup_longitude']].values\n",
    "\n",
    "if len(coords) > CLUSTERING_SAMPLE_SIZE:\n",
    "    np.random.seed(RANDOM_STATE)\n",
    "    sample_idx = np.random.choice(len(coords), CLUSTERING_SAMPLE_SIZE, replace=False)\n",
    "    coords_sample = coords[sample_idx]\n",
    "    df_sample = df.iloc[sample_idx].copy()\n",
    "else:\n",
    "    coords_sample = coords\n",
    "    df_sample = df.copy()\n",
    "\n",
    "print(f\"Clustering sample: {len(coords_sample):,}\")\n",
    "print(f\"Full data: {len(df):,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "# Train HDBSCAN\n",
    "coords_rad = np.radians(coords_sample)\n",
    "\n",
    "clusterer = hdbscan.HDBSCAN(\n",
    "    min_cluster_size=MIN_CLUSTER_SIZE,\n",
    "    min_samples=MIN_SAMPLES,\n",
    "    metric='haversine',\n",
    "    cluster_selection_method='eom',\n",
    "    cluster_selection_epsilon=CLUSTER_SELECTION_EPSILON,\n",
    "    core_dist_n_jobs=-1\n",
    ")\n",
    "\n",
    "labels = clusterer.fit_predict(coords_rad)\n",
    "probs = clusterer.probabilities_\n",
    "\n",
    "unique_labels = np.unique(labels)\n",
    "n_clusters = len(unique_labels) - (1 if -1 in unique_labels else 0)\n",
    "n_noise = (labels == -1).sum()\n",
    "\n",
    "print(f\"Clusters found: {n_clusters}\")\n",
    "print(f\"Noise points: {n_noise} ({n_noise/len(labels)*100:.1f}%)\")\n",
    "print(f\"Cluster labels: {sorted([l for l in unique_labels if l != -1])}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "# Visualize clusters\n",
    "plt.figure(figsize=(12, 10))\n",
    "\n",
    # Plot noise\n",
    "noise_mask = labels == -1\n",
    "if noise_mask.any():\n",
    "    plt.scatter(coords_sample[noise_mask, 1], coords_sample[noise_mask, 0], \n",
    "               c='lightgray', s=1, alpha=0.5, label='Noise')\n",
    "\n",
    # Plot clusters\n",
    "for label in sorted([l for l in unique_labels if l != -1]):\n",
    "    mask = labels == label\n",
    "    plt.scatter(coords_sample[mask, 1], coords_sample[mask, 0], \n",
    "               s=2, alpha=0.7, label=f'Zone {label}')\n",
    "\n",
    "plt.xlabel('Longitude')\n",
    "plt.ylabel('Latitude')\n",
    "plt.title('HDBSCAN Demand Zones (Sample)')\n",
    "plt.legend(markerscale=5)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "# Build enhanced zone lookup with demand profiles\n",
    "from sklearn.neighbors import BallTree\n",
    "\n",
    "unique_labels = np.unique(labels)\n",
    "unique_labels = unique_labels[unique_labels != -1]\n",
    "\n",
    "zones = []\n",
    "for label in unique_labels:\n",
    "    mask = labels == label\n",
    "    zone_coords = coords_sample[mask]\n",
    "    zone_probs = probs[mask]\n",
    "    \n",
    "    # Weighted center by membership probability\n",
    "    center_lat = np.average(zone_coords[:, 0], weights=zone_probs)\n",
    "    center_lon = np.average(zone_coords[:, 1], weights=zone_probs)\n",
    "    zone_size = mask.sum()\n",
    "    avg_prob = zone_probs.mean()\n",
    "    \n",
    "    # Demand from full dataset\n",
    "    zone_center_rad = np.radians([[center_lat, center_lon]])\n",
    "    full_coords_rad = np.radians(df[['pickup_latitude', 'pickup_longitude']].values)\n",
    "    \n",
    "    tree = BallTree(full_coords_rad, metric='haversine')\n",
    "    radius_rad = 1.0 / EARTH_RADIUS_KM\n",
    "    indices = tree.query_radius(zone_center_rad, r=radius_rad)[0]\n",
    "    nearby = df.iloc[indices]\n",
    "    \n",
    "    if len(nearby) == 0:\n",
    "        indices = tree.query(zone_center_rad, k=min(500, len(full_coords_rad)))[1][0]\n",
    "        nearby = df.iloc[indices]\n",
    "    \n",
    "    # Demand profiles\n",
    "    demand_by_hour = nearby.groupby('pickup_hour').size().to_dict()\n",
    "    demand_by_day = nearby.groupby('pickup_dayofweek').size().to_dict()\n",
    "    demand_by_month = nearby.groupby('pickup_month').size().to_dict()\n",
    "    \n",
    "    peak_hour = max(demand_by_hour, key=demand_by_hour.get) if demand_by_hour else 12\n",
    "    peak_day = max(demand_by_day, key=demand_by_day.get) if demand_by_day else 0\n",
    "    \n",
    "    total_demand = len(nearby)\n",
    "    hourly_demand = np.array([demand_by_hour.get(h, 0) for h in range(24)])\n",
    "    \n",
    "    # Zone spread\n",
    "    zone_spread_km = haversine_distance(\n",
    "        zone_coords[:, 0].min(), zone_coords[:, 1].min(),\n",
    "        zone_coords[:, 0].max(), zone_coords[:, 1].max()\n",
    "    )\n",
    "    \n",
    "    zones.append({\n",
    "        'zone_id': int(label),\n",
    "        'center_lat': float(center_lat),\n",
    "        'center_lon': float(center_lon),\n",
    "        'zone_size': int(zone_size),\n",
    "        'avg_membership_prob': float(avg_prob),\n",
    "        'zone_spread_km': float(zone_spread_km),\n",
    "        'total_demand': int(total_demand),\n",
    "        'peak_hour': int(peak_hour),\n",
    "        'peak_day': int(peak_day),\n",
    "        'demand_by_hour': demand_by_hour,\n",
    "        'demand_by_day': demand_by_day,\n",
    "        'demand_by_month': demand_by_month,\n",
    "        'hourly_demand_array': hourly_demand.tolist(),\n",
    "        'demand_mean': float(hourly_demand.mean()),\n",
    "        'demand_std': float(hourly_demand.std()),\n",
    "        'demand_percentile_90': float(np.percentile(hourly_demand, 90))\n",
    "    })"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "# Precompute normalized demand\n",
    "for z in zones:\n",
    "    hourly = z['hourly_demand_array']\n",
    "    peak = max(hourly) if max(hourly) > 0 else 1\n",
    "    z['demand_peak_normalized'] = [h / peak for h in hourly]\n",
    "    z['demand_cumulative'] = np.cumsum(hourly).tolist()\n",
    "\n",
    "# Build spatial index for fast lookup\n",
    "zone_centers = np.array([[z['center_lat'], z['center_lon']] for z in zones])\n",
    "zone_centers_rad = np.radians(zone_centers)\n",
    "zone_tree = BallTree(zone_centers_rad, metric='haversine')\n",
    "zone_ids = np.array([z['zone_id'] for z in zones])\n",
    "\n",
    "zone_lookup = {\n",
    "    'zones': zones,\n",
    "    'zone_tree': zone_tree,\n",
    "    'zone_ids': zone_ids,\n",
    "    'zone_centers_rad': zone_centers_rad,\n",
    "    'n_zones': len(zones),\n",
    "    'clustering_method': 'HDBSCAN',\n",
    "    'min_cluster_size': MIN_CLUSTER_SIZE,\n",
    "    'min_samples': MIN_SAMPLES\n",
    "}\n",
    "\n",
    "print(f\"Created {len(zones)} zones\")\n",
    "for z in zones:\n",
    "    print(f\"  Zone {z['zone_id']}: center=({z['center_lat']:.4f}, {z['center_lon']:.4f}), \"\n",
    "          f\"size={z['zone_size']}, demand={z['total_demand']:,}, \"\n",
    "          f\"peak={z['peak_hour']}:00, spread={z['zone_spread_km']:.1f}km, \"\n",
    "          f\"prob={z['avg_membership_prob']:.3f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "# Test predictions\n",
    "def predict_zone(zone_lookup, lat, lon):\n",
    "    point_rad = np.radians([[lat, lon]])\n",
    "    distances, indices = zone_lookup['zone_tree'].query(point_rad, k=1)\n",
    "    zone_idx = indices[0, 0]\n",
    "    zone_id = int(zone_lookup['zone_ids'][zone_idx])\n",
    "    distance_km = float(distances[0, 0] * EARTH_RADIUS_KM)\n",
    "    return zone_id, distance_km\n",
    "\n",
    "def get_zone_demand(zone_lookup, zone_id, hour=None, dayofweek=None, month=None):\n",
    "    zone = next((z for z in zone_lookup['zones'] if z['zone_id'] == zone_id), None)\n",
    "    if not zone:\n",
    "        return 0\n",
    "    if hour is not None:\n",
    "        return zone['demand_by_hour'].get(hour, 0)\n",
    "    if dayofweek is not None:\n",
    "        return zone['demand_by_day'].get(dayofweek, 0)\n",
    "    if month is not None:\n",
    "        return zone['demand_by_month'].get(month, 0)\n",
    "    return zone['total_demand']\n",
    "\n",
    "def get_demand_level(zone_lookup, zone_id, hour=None):\n",
    "    zone = next((z for z in zone_lookup['zones'] if z['zone_id'] == zone_id), None)\n",
    "    if not zone:\n",
    "        return 0.0\n",
    "    if hour is not None:\n",
    "        return zone['demand_peak_normalized'][hour]\n",
    "    return zone['demand_mean'] / zone['demand_percentile_90'] if zone['demand_percentile_90'] > 0 else 0.0\n",
    "\n",
    "test_points = [\n",
    "    (40.7580, -73.9855, \"Times Square\"),\n",
    "    (40.7484, -73.9857, \"Empire State\"),\n",
    "    (40.7128, -74.0060, \"City Hall\"),\n",
    "    (40.7812, -73.9665, \"Central Park\"),\n",
    "    (40.7282, -73.7949, \"JFK Airport\"),\n",
    "    (40.7769, -73.8740, \"LaGuardia Airport\"),\n",
    "]\n",
    "\n",
    "print(\"Test Predictions:\")\n",
    "for lat, lon, name in test_points:\n",
    "    zone_id, dist = predict_zone(zone_lookup, lat, lon)\n",
    "    z = next(z for z in zones if z['zone_id'] == zone_id)\n",
    "    demand_11 = get_zone_demand(zone_lookup, zone_id, hour=11)\n",
    "    demand_18 = get_zone_demand(zone_lookup, zone_id, hour=18)\n",
    "    level_11 = get_demand_level(zone_lookup, zone_id, hour=11)\n",
    "    level_18 = get_demand_level(zone_lookup, zone_id, hour=18)\n",
    "    print(f\"  {name}: Zone {zone_id} (dist={dist:.3f}km)\")\n",
    "    print(f\"    Demand 11am: {demand_11} (level={level_11:.2f}), 6pm: {demand_18} (level={level_18:.2f})\")"
   ]
  },
