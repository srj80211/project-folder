   "source": [
    "# NYC Taxi Demand Zones - Version 2 (Optimized)\n",
    "\n",
    "**Model**: HDBSCAN clustering with haversine metric\n",
    "**Data**: 1.45M NYC taxi trips (2016)\n",
    "**Output**: 7 demand zones with hourly/daily/monthly profiles\n",
    "**Artifact**: `demand_zones_model_optimized.pkl` + JSON exports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "import warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import joblib\n",
    "import json\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "\n",
    "print(\"Imports loaded\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "# Constants\n",
    "FILE_PATH = 'NYC.csv'\n",
    "\n",
    "MIN_TRIP_DURATION_SEC = 60\n",
    "MAX_TRIP_DURATION_SEC = 36_000\n",
    "MIN_PASSENGERS = 1\n",
    "MAX_PASSENGERS = 7\n",
    "\n",
    "NYC_BOUNDS = {\n",
    "    'min_lon': -74.5, 'max_lon': -73.3,\n",
    "    'min_lat': 40.5, 'max_lat': 41.2,\n",
    "}\n",
    "\n",
    "CLUSTERING_SAMPLE_SIZE = 100_000\n",
    "RANDOM_STATE = 42\n",
    "EARTH_RADIUS_KM = 6371\n",
    "\n",
    "# HDBSCAN params\n",
    "MIN_CLUSTER_SIZE = 100\n",
    "MIN_SAMPLES = 20\n",
    "CLUSTER_SELECTION_EPSILON = 0.00005  # ~0.3km in radians\n",
    "\n",
    "print(\"Constants defined\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {
    "trusted": true
   },
   "outputs": [],
   "source": [
    "def haversine_distance(lat1, lon1, lat2, lon2):\n",
    \"\"\"Calculate haversine distance between two points in km\"\"\"\n",
    "    lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])\n",
    "    dlat = lat2 - lat1\n",
    "    dlon = lon2 - lon1\n",
    "    a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2\n",
    "    c = 2 * np.arcsin(np.sqrt(a))\n",
    "    return EARTH_RADIUS_KM * c\n",
    "\n",
    "def load_and_clean_data(filepath):\n",
    \"\"\"Load and clean the NYC taxi data\"\"\"\n",
    "    df = pd.read_csv(filepath)\n",
    "    df['pickup_datetime'] = pd.to_datetime(df['pickup_datetime'])\n",
    "    df['dropoff_datetime'] = pd.to_datetime(df['dropoff_datetime'])\n",
    "    df['trip_duration_sec'] = (df['dropoff_datetime'] - df['pickup_datetime']).dt.total_seconds()\n",
    "    \n",
    "    # Filter\n",
    "    mask = (\n",
    "        (df['trip_duration_sec'] >= MIN_TRIP_DURATION_SEC) &\n",
    "        (df['trip_duration_sec'] <= MAX_TRIP_DURATION_SEC) &\n",
    "        (df['passenger_count'] >= MIN_PASSENGERS) &\n",
    "        (df['passenger_count'] <= MAX_PASSENGERS) &\n",
    "        (df['pickup_longitude'] >= NYC_BOUNDS['min_lon']) &\n",
    "        (df['pickup_longitude'] <= NYC_BOUNDS['max_lon']) &\n",
    "        (df['pickup_latitude'] >= NYC_BOUNDS['min_lat']) &\n",
    "        (df['pickup_latitude'] <= NYC_BOUNDS['max_lat']) &\n",
    "        (df['dropoff_longitude'] >= NYC_BOUNDS['min_lon']) &\n",
    "        (df['dropoff_longitude'] <= NYC_BOUNDS['max_lon']) &\n",
    "        (df['dropoff_latitude'] >= NYC_BOUNDS['min_lat']) &\n",
    "        (df['dropoff_latitude'] <= NYC_BOUNDS['max_lat'])\n",
    "    )\n",
    "    df = df[mask].copy()\n",
    "    \n",
    "    # Feature engineering\n",
    "    df['pickup_hour'] = df['pickup_datetime'].dt.hour\n",
    "    df['pickup_dayofweek'] = df['pickup_datetime'].dt.dayofweek\n",
    "    df['pickup_month'] = df['pickup_datetime'].dt.month\n",
    "    df['is_weekend'] = (df['pickup_dayofweek'] >= 5).astype(int)\n",
    "    df['distance_km'] = haversine_distance(\n",
    "        df['pickup_latitude'], df['pickup_longitude'],\n",
    "        df['dropoff_latitude'], df['dropoff_longitude']\n",
    "    )\n",
    "    \n",
    "    return df"
   ]
  },
